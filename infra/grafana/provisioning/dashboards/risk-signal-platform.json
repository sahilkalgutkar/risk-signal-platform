{
  "title": "Risk Signal Platform",
  "uid": "risk-signal-platform",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Transactions scored per minute, by risk level",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (level) (rate(risk_scores_total[1m]) * 60)",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP request rate (transaction-api)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{application=\"transaction-api\"}[1m]))",
          "legendFormat": "{{uri}} [{{status}}]"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM heap used, by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Process CPU usage, by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "process_cpu_usage",
          "legendFormat": "{{application}}"
        }
      ]
    }
  ]
}
