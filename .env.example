# Host ports the compose stack publishes. Every one is overridable, because
# 3306, 9092, 9200, 5601, 9090 and 3000 are usually already taken on a machine
# that has run a MySQL, a Kafka, an ELK stack or a Grafana for anything else,
# and a single collision aborts the whole `docker compose up`.
#
# Only the host side moves -- inside the compose network the services still
# reach MySQL, Kafka and Elasticsearch on the standard ports, so nothing else
# needs changing.
#
# Copy this to .env next to docker-compose.yml, or set them inline:
#   MYSQL_HOST_PORT=13306 KAFKA_HOST_PORT=19092 docker compose up --build

MYSQL_HOST_PORT=3306
KAFKA_HOST_PORT=9092
ELASTICSEARCH_HOST_PORT=9200
KIBANA_HOST_PORT=5601
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
TRANSACTION_API_HOST_PORT=8081
RISK_SCORING_HOST_PORT=8082
ALERT_SERVICE_HOST_PORT=8083
